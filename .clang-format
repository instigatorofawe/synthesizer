---
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 120
IncludeBlocks: Regroup
IncludeCategories: # First match wins
  - Regex: '^<modsynth/'
    Priority: 2
  - Regex: '^<'
    Priority: 1
  - Regex: '^"'
    Priority: 3
IncludeIsMainRegex: '$.' # Never matches: Google's rule would otherwise move a quoted main header to the top
