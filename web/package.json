{
  "name": "modsynth-web",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "HOST=127.0.0.1 PORT=5321 BODY_SIZE_LIMIT=64M node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "wasm": "node scripts/CopyWasm.js",
    "db:generate": "drizzle-kit generate",
    "e2e": "playwright test",
    "e2e:stress": "sh scripts/E2eStress.sh",
    "e2e:linux": "sh scripts/LinuxE2e.sh"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "svelte": "5.57.3",
    "vexflow": "5.0.0",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.16.1"
}
